<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PaifuViewer</RootNamespace>
    <AssemblyName>PaifuViewer</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ブラウザ版（Wasm フォルダ）は別プロジェクト -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Wasm\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
