<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    ブラウザだけで動く版（Blazor WebAssembly）。GitHub Pages などの静的ホスティングに置ける。
    牌譜の処理（Core）・画面（Viewer.razor）・CSS/JS・牌画像はサーバー版（親フォルダ）のファイルをそのまま使う。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PaifuViewer</RootNamespace>
    <AssemblyName>PaifuEditor.Wasm</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 文化圏データ（ICU）を含めず、ダウンロードを小さくする -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Content Include="..\Components\Pages\Viewer.razor" Link="Pages\Viewer.razor" />
    <Content Include="..\wwwroot\app.css;..\wwwroot\app.js" Link="wwwroot\%(Filename)%(Extension)" />
    <Content Include="..\wwwroot\tiles\*.*" Link="wwwroot\tiles\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
