@page "/"
@implements IDisposable
@inject IJSRuntime JS
@using System.Globalization

<div class="app">
    <header class="top">
        <b class="logo">楽々牌譜エディター</b>
        <label class="btn">牌譜を読み込む<InputFile OnChange="OnFile" accept=".json,application/json" hidden /></label>
        @if (S.Loaded)
        {
            <button class="@(showWall ? "on" : null)" @onclick="() => showWall = !showWall">牌山</button>
        }
        <label>視点
            <select value="@ViewQ" disabled="@(!S.Loaded || FollowingTurn)" @onchange="e => S.View = int.Parse((string)e.Value)">
                @if (S.Loaded)
                {
                    for (int q = 0; q < 4; q++)
                    {
                        <option value="@q">@S.Nmq(q)</option>
                    }
                }
            </select>
        </label>
        @if (S.Branching)
        {
            @* 分岐中は全員の手牌を表で表示するため、代わりに手番の視点へ自動で移動するかを選ぶ *@
            <label><input type="checkbox" @bind="followTurn" /> 手番の視点に移動する</label>
        }
        else
        {
            <label><input type="checkbox" @bind="showOthers" /> 他家の手牌を表向きに表示</label>
        }
        <span class="ttl">@(error ?? (S.Loaded ? S.RoundName + (S.Branching ? "　● 分岐編集中" : "　● 牌譜を閲覧中") : ""))</span>
    </header>

    @if (S.Loaded)
    {
        var s = S.Cs;
        int v = ViewQ;
        var A = S.Acts;
        var picked = ReferenceEquals(selStep, s) ? sel : new List<int>();
        <div class="main">
            <aside class="left">
                <h3>局一覧</h3>
                <div class="rl">
                    @for (int j = 0; j < S.Rounds.Count; j++)
                    {
                        int jj = j;
                        <button class="@(j == S.Rc ? "on" : null)" @onclick="() => { Play(false); S.SetRound(jj); }">@ViewerState.Rname(J.L(S.Rounds[j]))</button>
                    }
                </div>
                <h3>局情報</h3>
                <div class="pad">
                    @S.RoundName<br />
                    ドラ @string.Join(" ", S.Dora(s).Select(Tiles.Tn))<br />
                    供託 @S.Kyotaku(s).ToString("N0")<br />
                    <span class="@(S.RD.HasWall ? "wall-ok" : "wall-ng")">@S.RD.WallStatus</span>
                </div>
                <h3>巡目選択</h3>
                <div class="pad">
                    <div class="jr">
                        <button @onclick="() => S.Jump(-1)">◀</button>
                        <span>@(S.Branching ? s.Jn + "巡目（分岐 " + S.Bi + "/" + (S.BR.Count - 1) + "手）" : s.Jn + " / " + S.Last.Jn + "巡目（" + S.I + "/" + (S.Steps.Count - 1) + "手）")</span>
                        <button @onclick="() => S.Jump(1)">▶</button>
                    </div>
                    <input type="range" class="sl" min="0" max="@(S.Count - 1)" value="@S.Cx" @oninput="e => S.Go(int.Parse((string)e.Value))" />
                    <div class="evs">
                        @foreach (var ev in S.Events)
                        {
                            var j = ev.Key;
                            <button @onclick="() => S.Go(j)">@ev.Value</button>
                        }
                    </div>
                </div>
                <h3>再生</h3>
                <div class="pad play">
                    <button @onclick="() => S.Go(S.Cx - 1)">◀</button>
                    <button @onclick="() => Play(!playing)">@(playing ? "⏸" : "▶")</button>
                    <button @onclick="() => S.Go(S.Cx + 1)">▶|</button>
                    <select value="@speed.ToString(CultureInfo.InvariantCulture)" @onchange="SetSpeed">
                        <option value="0.5">0.5×</option>
                        <option value="1">1.0×</option>
                        <option value="2">2.0×</option>
                        <option value="4">4.0×</option>
                    </select>
                </div>
            </aside>

            <section class="center">
                <h3>卓表示｜@(s.Jn)巡目　@(s.T >= 0 ? ViewerState.Wn(s.T, s) + " " + S.Nmq(s.T) + "の手番" : "局終了")　｜　@ViewerState.FirstLine(s.Msg)</h3>
                <svg class="board" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid meet"
                     @ondblclick="DoubleClick" @oncontextmenu="S.Through" @oncontextmenu:preventDefault="S.Branching">
                    <rect class="table @(TableClickable ? "clk" : null)" x="2" y="2" width="996" height="996" rx="18" @onclick="TableClick" />

                    @* 卓中央：局名・ドラ・供託・残り枚数 *@
                    <rect class="cbox" x="380" y="380" width="240" height="240" rx="10" />
                    <text class="cname" x="500" y="442">@S.RoundName</text>
                    @{
                        var dora = S.Dora(s);
                        double dx = 500 - dora.Count * 30 / 2.0;
                    }
                    @foreach (var c in dora)
                    {
                        @Img(c, dx, 458, 28, 37)
                        dx += 30;
                    }
                    <text class="cinfo" x="500" y="509">供託 @S.Kyotaku(s).ToString("N0")　残り @(s.Wall)枚</text>

                    @* 各家（自分の席を下にして描き、回転させる）*@
                    @for (int q0 = 0; q0 < 4; q0++)
                    {
                        int q = q0;
                        var p = s.Pl[q];
                        int pos = (q - v + 4) % 4;
                        bool turn = s.T == q, open = q == v || showOthers || S.Branching, canDiscard = A.DiscardQ == q;
                        <g transform="@(pos == 0 ? null : "rotate(" + (pos == 1 ? -90 : pos == 2 ? 180 : 90) + " 500 500)")">
                            @* 名札 *@
                            @if (turn)
                            {
                                <rect class="tag-on" x="386" y="576" width="228" height="40" rx="6" />
                            }
                            <text class="tag1 @(turn ? "on" : null)" x="500" y="587">@ViewerState.Wn(q, s)　@S.Nmq(q)</text>
                            <text class="tag2 @(turn ? "on" : null)" x="500" y="606">@s.Sc[q].ToString("N0")@(p.Ri ? "　立直" : "")</text>

                            @* 河（6 枚ごとに改行、立直宣言牌は横向き）*@
                            @{
                                double rx = RiverX;
                            }
                            @for (int j = 0; j < p.Rv.Count; j++)
                            {
                                if (j > 0 && j % 6 == 0) rx = RiverX;
                                double ry = RiverY + (j / 6) * (RH + 2);
                                var r = p.Rv[j];
                                bool target = A.TargetQ == q && j == p.Rv.Count - 1;
                                string cls = (r.G ? "tsumogiri " : "") + (target ? "target" : "");
                                if (r.R)
                                {
                                    @Img(r.C, rx, ry + RH - RW, RH, RW, true, cls, r.X)
                                    rx += RH + 1;
                                }
                                else
                                {
                                    @Img(r.C, rx, ry, RW, RH, false, cls, r.X)
                                    rx += RW + 1;
                                }
                            }

                            @* 手牌 *@
                            @{
                                double hx = HandX;
                            }
                            @for (int j = 0; j < p.H.Count; j++)
                            {
                                if (!open)
                                {
                                    <rect class="back" x="@F(hx)" y="@F(HandY)" width="@F(TW)" height="@F(TH)" rx="4" />
                                }
                                else if (canDiscard && A.HandOk[j])
                                {
                                    @Clickable(p.H[j], hx, HandY, TW, TH, A.HandActions[j])
                                }
                                else if (CallTile(q, p.H[j]))
                                {
                                    int jj = j;
                                    @Clickable(p.H[j], hx, HandY, TW, TH, () => PickCallTile(q, jj), picked.Contains(j) && selQ == q ? "sel" : null)
                                }
                                else
                                {
                                    @Img(p.H[j], hx, HandY, TW, TH, false, null, canDiscard)
                                }
                                hx += TW + 1;
                            }
                            @if (p.Dw.HasValue)
                            {
                                hx += 12;
                                if (!open)
                                {
                                    <rect class="back" x="@F(hx)" y="@F(HandY)" width="@F(TW)" height="@F(TH)" rx="4" />
                                }
                                else if (canDiscard && A.DrawnOk)
                                {
                                    @Clickable(p.Dw.Value, hx, HandY, TW, TH, A.DrawnAction)
                                }
                                else
                                {
                                    @Img(p.Dw.Value, hx, HandY, TW, TH, false, null, canDiscard)
                                }
                                hx += TW + 1;
                            }

                            @* 副露（鳴いた牌は横向き、暗槓は両端を伏せる）*@
                            @{
                                hx += 20;
                            }
                            @foreach (var m in p.Ml)
                            {
                                for (int j = 0; j < m.T.Count; j++)
                                {
                                    if (j == m.Ci && m.L != 'a')
                                    {
                                        @Img(m.T[j], hx, HandY + TH - TW, TH, TW, true)
                                        hx += TH + 1;
                                    }
                                    else
                                    {
                                        if (m.L == 'a' && (j == 0 || j == 3))
                                        {
                                            <rect class="back" x="@F(hx)" y="@F(HandY)" width="@F(TW)" height="@F(TH)" rx="4" />
                                        }
                                        else
                                        {
                                            @Img(m.T[j], hx, HandY, TW, TH)
                                        }
                                        hx += TW + 1;
                                    }
                                }
                                hx += 10;
                            }
                        </g>
                    }

                    @* 操作ボタン：誰の操作でも視点の手牌の右上にまとめ、右から詰めて並べる（入りきらなければ上の段へ）*@
                    @{
                        double bRight = BarRight, by = ButtonY;
                    }
                    @foreach (var b in A.Buttons)
                    {
                        var lb = b.Q >= 0 ? new BoardButton { Q = b.Q, Label = Rel[(b.Q - v + 4) % 4] + " " + b.Label, Act = b.Act } : b;
                        double bw = BtnW(lb.Label, ButtonH);
                        if (bRight - bw < BarLeft && bRight < BarRight) { bRight = BarRight; by -= ButtonH + 8; }
                        @Btn(lb, bRight - bw, by, ButtonH)
                        bRight -= bw + 8;
                    }

                    @* 牌山が尽きたときのツモ牌選択 *@
                    @if (A.Unseen != null)
                    {
                        const int perRow = 10;
                        const double cw = 46, ch = 62;
                        int rows = Math.Max(1, (A.Unseen.Count + perRow - 1) / perRow);
                        double pw = perRow * cw + 40, ph = 50 + rows * ch + 64, px = (1000 - pw) / 2, py = (1000 - ph) / 2;
                        <g class="picker-layer">
                        <rect class="picker" x="@F(px)" y="@F(py)" width="@F(pw)" height="@F(ph)" rx="12" />
                        <text class="picker-ttl" x="500" y="@F(py + 26)">@S.N(s.T) のツモ牌を選択（未使用牌）</text>
                        @for (int j = 0; j < A.Unseen.Count; j++)
                        {
                            int c = A.Unseen[j];
                            @Clickable(c, px + 20 + (j % perRow) * cw + 3, py + 50 + (j / perRow) * ch + 4, cw - 6, ch - 8, () => A.PickAction(c))
                        }
                        @Btn(new BoardButton { Label = "ランダム", Act = S.PickRandom }, 500 - BtnW("ランダム", 40) / 2, py + ph - 54, 40)
                        </g>
                    }
                </svg>
                @if (showWall)
                {
                    @WallView(s)
                }
            </section>

            <aside class="right">
                <h3>分岐</h3>
                <div class="pad">
                    @if (S.Branching)
                    {
                        <button @onclick="S.EndBranch">分岐終了（元牌譜へ戻る）</button>
                    }
                    else
                    {
                        <button @onclick="StartBranch">この局面から分岐開始</button>
                    }
                    @if (S.Branching && S.Bn != "")
                    {
                        <p class="note">@S.Bn</p>
                    }
                    <p class="hint-text">@A.Text</p>
                </div>
                <h3>シミュレーション</h3>
                <div class="pad sim">
                    @SimView(s, v)
                </div>
                <h3>状態</h3>
                <div class="pad">
                    手番　@(s.T >= 0 ? ViewerState.Wn(s.T, s) : "―")<br />
                    @(s.Jn)巡目 / 残り@(s.Wall)枚<br />
                    @for (int q = 0; q < 4; q++)
                    {
                        @(ViewerState.Wn(q, s) + " " + S.Nmq(q) + "  " + s.Sc[q].ToString("N0") + (s.Pl[q].Ri ? "（立直）" : ""))<br />
                    }
                </div>
                <h3>ログ</h3>
                <div class="pad log" id="lg">
                    @for (int j = 0; j < S.Log.Count; j++)
                    {
                        int jj = j;
                        <div class="@(j == S.Cx ? "cur" : null)" @onclick="() => S.Go(jj)">@(S.Log[j].Jn)巡目：@ViewerState.FirstLine(S.Log[j].Msg)</div>
                    }
                </div>
                <h3>局の結果</h3>
                <div class="pad res">@(S.Branching && s.Ph == "e" ? s.Msg : S.Last.Msg)</div>
            </aside>
        </div>
    }
    else
    {
        @* 読み込み前：各欄と卓は空のまま表示する *@
        <div class="main">
            <aside class="left">
                <h3>局一覧</h3>
                <h3>局情報</h3>
                <h3>巡目選択</h3>
                <h3>再生</h3>
            </aside>
            <section class="center">
                <h3>卓表示</h3>
                <svg class="board" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid meet">
                    <rect class="table" x="2" y="2" width="996" height="996" rx="18" />
                    <text class="empty-msg" x="500" y="500">牌譜（JSON）を読み込んでください</text>
                </svg>
            </section>
            <aside class="right">
                <h3>分岐</h3>
                <h3>シミュレーション</h3>
                <h3>状態</h3>
                <h3>ログ</h3>
                <h3>局の結果</h3>
            </aside>
        </div>
    }

    <footer class="hint">操作：← → 1手移動　Space 再生/停止　JSONはドラッグ＆ドロップでも読み込めます　｜　牌画像：<a href="https://mj-king.net/sozai/" target="_blank" rel="noopener">麻雀王国 麻雀素材</a></footer>
</div>

@code {
    // ---- 卓の寸法（仮想座標 1000×1000）----
    const double HandX = 90, HandY = 934, TW = 40, TH = 54;      // 手牌
    const double RiverX = 390, RiverY = 630, RW = 34, RH = 46;   // 河
    const double ButtonY = 876, ButtonH = 44;                    // 操作ボタン（下段の y）
    const double BarLeft = 620, BarRight = 925;                  // 操作ボタンを置く範囲（右隣の家の手牌に重ならない幅）

    static readonly string[] Honors = { "ji_e", "ji_s", "ji_w", "ji_n", "no", "ji_h", "ji_c" };
    static readonly string[] Rel = { "自家", "下家", "対面", "上家" };   // 視点から見た相対位置

    readonly ViewerState S = new ViewerState();
    string error;
    bool showOthers = true, playing, showWall, followTurn;
    double speed = 1;
    System.Threading.Timer timer;
    DotNetObjectReference<Viewer> self;
    int scrolledTo = -1;

    // 手牌クリックで選んでいるチー・ポンの牌（selStep の局面での selQ の家の手牌の添字）
    readonly List<int> sel = new List<int>();
    Step selStep;
    int selQ = -1;

    bool FollowingTurn => S.Branching && followTurn;

    /// <summary>表示する視点。「手番の視点に移動する」がオンなら分岐中は手番の家。</summary>
    int ViewQ => S.Loaded && FollowingTurn && S.Cs.T >= 0 ? S.Cs.T : S.View ?? 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("paifu.init", self);
        }
        if (S.Loaded && S.Cx != scrolledTo)
        {
            scrolledTo = S.Cx;
            await JS.InvokeVoidAsync("paifu.scrollLog");
        }
        if (S.Loaded) SimUpdate();
    }

    static string F(double d) { return d.ToString("0.##", CultureInfo.InvariantCulture); }

    /// <summary>牌画像の URL（麻雀王国 牌画2。赤5 は事前に着色した PNG）。</summary>
    static string Url(int c, bool side)
    {
        int n = Tiles.Norm(c), s = n / 10, k = n % 10;
        string b = s == 4 ? "p_" + Honors[k - 1] : "p_" + "mps"[s - 1] + "s" + k;
        return "tiles/" + b + (c > 50 ? "r_" : "_") + (side ? "3" : "1") + (c > 50 ? ".png" : ".gif");
    }

    RenderFragment Img(int c, double x, double y, double w, double h, bool side = false, string cls = null, bool dim = false) =>
        @<g class="tile @cls @(dim ? "dim" : null)">
            <image href="@Url(c, side)" x="@F(x)" y="@F(y)" width="@F(w)" height="@F(h)" preserveAspectRatio="none" />
            <rect class="ol" x="@F(x)" y="@F(y)" width="@F(w)" height="@F(h)" rx="4" />
        </g>;

    RenderFragment Clickable(int c, double x, double y, double w, double h, Action act, string cls = null) =>
        @<g class="tile clk @cls" @onclick="act">
            <rect class="hit" x="@F(x)" y="@F(y)" width="@F(w)" height="@F(h + 12)" />
            <image href="@Url(c, false)" x="@F(x)" y="@F(y)" width="@F(w)" height="@F(h)" preserveAspectRatio="none" />
            <rect class="ol" x="@F(x)" y="@F(y)" width="@F(w)" height="@F(h)" rx="4" />
        </g>;

    /// <summary>全角 1em・半角 0.58em として幅を見積もる。</summary>
    static double BtnW(string label, double h)
    {
        double fs = h * 0.42;
        return label.Sum(ch => ch < 128 ? 0.58 : 1.0) * fs + 26;
    }

    RenderFragment Btn(BoardButton b, double x, double y, double h) =>
        @<g class="bbtn" @onclick="b.Act">
            <rect x="@F(x)" y="@F(y)" width="@F(BtnW(b.Label, h))" height="@F(h)" rx="8" />
            <text x="@F(x + BtnW(b.Label, h) / 2)" y="@F(y + h / 2)" style="font-size:@F(h * 0.42)px">@b.Label</text>
        </g>;

    bool CanTsumogiri => S.Branching && S.Acts.DrawnOk && S.Acts.DrawnAction != null;

    /// <summary>卓クリックで何か起きるか：閲覧中は 1 手進む、分岐中はツモ切り（ツモ待ちなら牌山どおりにツモ）。</summary>
    bool TableClickable => S.Loaded && (!S.Branching ? S.Cx < S.Count - 1 : CanTsumogiri || S.Cs.Ph == "w" && S.Acts.Unseen == null);

    Step clickedAt;   // 直前に卓をクリックしたときの局面

    void TableClick()
    {
        if (!S.Loaded) return;
        clickedAt = S.Cs;
        if (!S.Branching) { Play(false); S.Go(S.Cx + 1); }
        else if (CanTsumogiri) S.Acts.DrawnAction();
        else if (S.Cs.Ph == "w" && S.Acts.Unseen == null) S.Go(S.Cx + 1);
    }

    /// <summary>
    /// ダブルクリックでスルー。ダブルクリックの 1 回目のクリックでツモ切りした場合（その打牌への操作待ちになった直後）は
    /// スルーしない。
    /// </summary>
    void DoubleClick()
    {
        if (ReferenceEquals(clickedAt, S.Cs)) S.Through();
    }

    /// <summary>q の家の手牌の牌 c がチー・ポンに使えるか。</summary>
    bool CallTile(int q, int c) => S.Acts.Calls.Any(o => o.Q == q && o.Use.Any(u => Tiles.Norm(u) == Tiles.Norm(c)));

    /// <summary>
    /// 鳴きに使う手牌を 1 枚ずつ選ぶ。選んだ牌を含む鳴き方が 1 通りに決まったら、その牌で鳴く。
    /// 例：4m に対して 2356m なら、2 を選べば 23 でチー、3 を選ぶと 23・35 の 2 通りなので次の 1 枚を待つ。
    /// </summary>
    void PickCallTile(int q, int j)
    {
        var s = S.Cs;
        if (!ReferenceEquals(selStep, s) || selQ != q) { sel.Clear(); selStep = s; selQ = q; }
        if (sel.Remove(j)) return;
        sel.Add(j);
        var h = s.Pl[q].H;
        var opts = MatchCalls(q, h);
        if (opts.Count == 0) { sel.Clear(); sel.Add(j); opts = MatchCalls(q, h); }
        if (opts.Count != 1) return;

        // 選んだ牌（赤5 などの区別を保つ）に、残りを既定の牌で補う
        var use = sel.Select(i => h[i]).ToList();
        var rest = new List<int>(opts[0].Use);
        foreach (int c in use) rest.RemoveAt(rest.FindIndex(x => Tiles.Norm(x) == Tiles.Norm(c)));
        use.AddRange(rest);
        Tiles.Sort(use);
        sel.Clear();
        opts[0].Exec(use);
    }

    List<CallOption> MatchCalls(int q, List<int> h)
    {
        return S.Acts.Calls.Where(o =>
        {
            if (o.Q != q) return false;
            var rest = o.Use.Select(Tiles.Norm).ToList();
            return sel.All(i => rest.Remove(Tiles.Norm(h[i])));
        }).ToList();
    }

    /// <summary>牌山：牌山データがあれば 136 枚を配牌・ツモ山・王牌に分けて、なければ牌譜のツモ順を表示する。</summary>
    RenderFragment WallView(Step s) => __builder =>
    {
        var rd = S.RD;
        <div class="wall-pop">
            <div class="wall-hd">
                <b>牌山</b><span class="@(rd.HasWall ? "wall-ok" : "wall-ng")">@rd.WallStatus</span>
                <button @onclick="() => showWall = false">閉じる</button>
            </div>
            @if (rd.HasWall)
            {
                var dead = rd.Wall.Skip(WallAligner.Total - WallAligner.Dead).ToList();
                <h4>配牌（@(rd.WallStart)枚）</h4>
                <div class="wall-row">
                    @foreach (var c in rd.Wall.Take(rd.WallStart))
                    {
                        <img src="@Url(c, false)" class="used" />
                    }
                </div>
                <h4>ツモ山（@(rd.LW.Count)枚・ツモ済み @(s.Ld)枚）</h4>
                <div class="wall-row">
                    @for (int j = 0; j < rd.LW.Count; j++)
                    {
                        <img src="@Url(rd.LW[j], false)" class="@(j < s.Ld ? "used" : j == s.Ld ? "next" : null)" title="@(j + 1)枚目" />
                    }
                </div>
                <h4>王牌（14枚）</h4>
                <div class="wall-row">
                    @for (int j = 0; j < dead.Count; j++)
                    {
                        int ri = rd.RinshanPos == null ? -1 : Array.IndexOf(rd.RinshanPos, j);
                        <span class="dead">
                            <img src="@Url(dead[j], false)" class="@(ri >= 0 && ri < s.Rd ? "used" : null)" />
                            <small>@(ri >= 0 ? "嶺上" + (ri + 1) : "")</small>
                        </span>
                    }
                </div>
            }
            else
            {
                <h4>牌譜のツモ順（@(rd.LW.Count)枚・ツモ済み @(s.Ld)枚）</h4>
                <div class="wall-row">
                    @for (int j = 0; j < rd.LW.Count; j++)
                    {
                        <img src="@Url(rd.LW[j], false)" class="@(j < s.Ld ? "used" : j == s.Ld ? "next" : null)" />
                    }
                </div>
                <h4>嶺上ツモ（@(rd.RW.Count)枚）</h4>
                <div class="wall-row">
                    @for (int j = 0; j < rd.RW.Count; j++)
                    {
                        <img src="@Url(rd.RW[j], false)" class="@(j < s.Rd ? "used" : null)" />
                    }
                </div>
            }
            <h4>ドラ表示牌</h4>
            <div class="wall-row">
                @foreach (var c in S.Dora(s))
                {
                    <img src="@Url(c, false)" />
                }
            </div>
        </div>
    };

    void StartBranch()
    {
        Play(false);
        S.StartBranch();
    }

    void Play(bool on)
    {
        timer?.Dispose();
        timer = null;
        playing = on;
        if (!on) return;
        int ms = (int)(800 / speed);
        timer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (!playing) return;
            if (S.Cx >= S.Count - 1) Play(false); else S.Go(S.Cx + 1);
            StateHasChanged();
        }), null, ms, ms);
    }

    void SetSpeed(ChangeEventArgs e)
    {
        speed = double.Parse((string)e.Value, CultureInfo.InvariantCulture);
        if (playing) Play(true);
    }

    async Task OnFile(InputFileChangeEventArgs e)
    {
        using var sr = new StreamReader(e.File.OpenReadStream(10 * 1024 * 1024));
        LoadText(await sr.ReadToEndAsync());
    }

    void LoadText(string text)
    {
        try
        {
            Play(false);
            S.Load(text);
            error = null;
        }
        catch (Exception ex) { error = "読み込めませんでした：" + ex.Message; }
    }

    [JSInvokable]
    public Task LoadJson(string text) => InvokeAsync(() => { LoadText(text); StateHasChanged(); });

    [JSInvokable]
    public Task OnKey(string key) => InvokeAsync(() =>
    {
        if (!S.Loaded) return;
        if (key == "ArrowLeft") S.Go(S.Cx - 1);
        else if (key == "ArrowRight") S.Go(S.Cx + 1);
        else if (key == "Space") Play(!playing);
        StateHasChanged();
    });

    // =====================================================================
    // シミュレーション（局面が変わるたびに背景で計算し、結果を局面ごとに覚えておく）
    // =====================================================================

    static readonly string[] SimNames = { "自家和了", "放銃", "他家ツモ", "横移動", "流局" };
    // ブラウザ（WebAssembly）は 1 スレッドで計算するため、試行回数を少なめにする
    static readonly int[] SimTrialOpts = OperatingSystem.IsBrowser() ? new[] { 30, 100, 300 } : new[] { 100, 300, 1000 };

    bool simOn = true;
    int simTrials = OperatingSystem.IsBrowser() ? 100 : 300;
    SimResult sim;
    double simProg;
    string simError;
    Step simStep;                                   // sim を計算している局面
    System.Threading.CancellationTokenSource simCts, trendCts;
    double trendProg = -1;
    // 計算済みの結果。視点・試行回数・局が変わったら捨てる
    readonly Dictionary<Step, SimResult> simCache = new Dictionary<Step, SimResult>();
    readonly Dictionary<Step, SimOutcome> trend = new Dictionary<Step, SimOutcome>();
    (int v, int n, RoundData rd) simCacheKey;

    static int[] Parts(SimOutcome o) => new[] { o.Win, o.DealIn, o.OtherTsumo, o.Yoko, o.Draw };

    void SimReset()
    {
        simCts?.Cancel();
        trendCts?.Cancel();
        simCache.Clear();
        trend.Clear();
        sim = null;
        simStep = null;
        trendProg = -1;
    }

    /// <summary>表示中の局面の結果がなければ計算を始める（描画のたびに呼ぶ）。</summary>
    void SimUpdate()
    {
        var key = (ViewQ, simTrials, S.RD);
        if (!simCacheKey.Equals(key)) { SimReset(); simCacheKey = key; }
        var step = S.Cs;
        if (!simOn || ReferenceEquals(step, simStep)) return;
        simCts?.Cancel();
        simStep = step;
        simError = null;
        SimResult hit;
        if (simCache.TryGetValue(step, out hit)) { sim = hit; simProg = 1; StateHasChanged(); return; }
        sim = null;
        simProg = 0;
        var cts = simCts = new System.Threading.CancellationTokenSource();
        var k = S.K;
        int v = ViewQ, n = simTrials;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(150, cts.Token);   // 連続で移動している間は計算しない
                var last = DateTime.MinValue;
                var r = await RunSim(step, k, v, n, cts.Token, (p, part) =>
                {
                    if ((DateTime.Now - last).TotalMilliseconds < 300) return;
                    last = DateTime.Now;
                    _ = InvokeAsync(() => { if (cts == simCts) { sim = part; simProg = p; StateHasChanged(); } });
                });
                await InvokeAsync(() =>
                {
                    if (cts.IsCancellationRequested) return;
                    simCache[step] = r;
                    if (r.Overall.N > 0) trend[step] = r.Overall;
                    if (cts == simCts) { sim = r; simProg = 1; }
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
            catch (Exception ex) { await InvokeAsync(() => { simError = ex.Message; StateHasChanged(); }); }
        });
    }

    /// <summary>
    /// シミュレーションを実行する。サーバーでは複数コアで並列に、ブラウザ（WebAssembly）では
    /// 画面が固まらないよう 1 本のスレッドで少しずつ処理を返しながら計算する。
    /// </summary>
    static Task<SimResult> RunSim(Step step, List<object> k, int v, int n, System.Threading.CancellationToken ct, Action<double, SimResult> progress = null, bool overallOnly = false)
    {
        if (OperatingSystem.IsBrowser()) return Simulator.RunAsync(step, k, v, n, ct, progress, overallOnly);
        return Task.Run(() => Simulator.Run(step, k, v, n, ct, progress, overallOnly), ct);
    }

    /// <summary>局面列のすべての手について、全体の結果だけを計算して推移グラフを埋める。</summary>
    void SimTrendAll()
    {
        trendCts?.Cancel();
        var cts = trendCts = new System.Threading.CancellationTokenSource();
        var log = S.Log.ToList();
        var k = S.K;
        int v = ViewQ, n = Math.Min(simTrials, 100);
        trendProg = 0;
        _ = Task.Run(async () =>
        {
            try
            {
                for (int j = 0; j < log.Count; j++)
                {
                    var step = log[j];
                    if (step.Ph == "e" || trend.ContainsKey(step)) continue;
                    var r = await RunSim(step, k, v, n, cts.Token, overallOnly: true);
                    int jj = j;
                    await InvokeAsync(() =>
                    {
                        if (cts.IsCancellationRequested) return;
                        if (!trend.ContainsKey(step)) trend[step] = r.Overall;
                        trendProg = (jj + 1.0) / log.Count;
                        StateHasChanged();
                    });
                }
                await InvokeAsync(() => { if (cts == trendCts) { trendProg = -1; StateHasChanged(); } });
            }
            catch (OperationCanceledException) { }
        });
    }

    void SimToggle()
    {
        simOn = !simOn;
        if (!simOn) { simCts?.Cancel(); trendCts?.Cancel(); trendProg = -1; simStep = null; sim = null; }
    }

    static string Pct(double r) => (r * 100).ToString("0.0", CultureInfo.InvariantCulture) + "%";
    static string Pts(double d) => (d >= 0 ? "+" : "") + Math.Round(d).ToString("N0");

    /// <summary>結果の内訳を 100% 積み上げの横棒で描く。</summary>
    RenderFragment SimBar(SimOutcome o, double h) => __builder =>
    {
        var ps = Parts(o);
        double x = 0;
        <svg class="sbar" viewBox="0 0 100 @F(h)" preserveAspectRatio="none" style="height:@F(h)px">
            <rect class="sbar-bg" x="0" y="0" width="100" height="@F(h)" rx="3" />
            @for (int i = 0; i < 5; i++)
            {
                double w = o.N == 0 ? 0 : 100.0 * ps[i] / o.N;
                if (w > 0)
                {
                    <rect class="sv@(i)" x="@F(x)" y="0" width="@F(Math.Max(0, w - 0.6))" height="@F(h)"><title>@SimNames[i] @Pct(o.Rate(ps[i]))（@ps[i] / @o.N 回）</title></rect>
                }
                x += w;
            }
        </svg>
    };

    /// <summary>このあとの局面で牌譜どおりに視点の家が切った牌（候補の印に使う）。</summary>
    int ActualCand(Step s, int v)
    {
        if (sim == null || S.Cx + 1 >= S.Count || s.Ph != "d" || s.T != v) return -1;
        var nx = S.Log[S.Cx + 1];
        if (nx.Ph != "c" || nx.T != v || nx.Pl[v].Rv.Count == 0) return -1;
        var r = nx.Pl[v].Rv.Last();
        return sim.Cands.FindIndex(c => c.Tile == r.C && c.Label.StartsWith("立直") == r.R && c.Label != "ツモ和了");
    }

    RenderFragment SimView(Step s, int v) => __builder =>
    {
        <div class="sim-ctl">
            <button class="@(simOn ? "on" : null)" @onclick="SimToggle">@(simOn ? "計算中止" : "計算する")</button>
            <label>試行
                <select value="@simTrials" @onchange="e => simTrials = int.Parse((string)e.Value)">
                    @foreach (var n in SimTrialOpts)
                    {
                        <option value="@n">@n 回</option>
                    }
                </select>
            </label>
            <button disabled="@(!simOn)" @onclick="SimTrendAll">全手の推移</button>
        </div>
        <p class="sim-sub">@(S.Nmq(v)) の視点。見えない牌を毎回並べ替え、4 人ともボット（雀魂の上位卓の成績に寄せた打ち方）で局の終わりまで打った結果です。</p>
        @if (!simOn)
        {
            <p class="sim-sub">計算は止めています。</p>
            return;
        }
        @if (simError != null)
        {
            <p class="note">計算できませんでした：@simError</p>
        }
        <div class="sim-leg">
            @for (int i = 0; i < 5; i++)
            {
                <span><i class="sw sv@(i)"></i>@SimNames[i]</span>
            }
        </div>
        @if (s.Ph == "e")
        {
            <p class="sim-sub">局終了：@ViewerState.FirstLine(s.Msg)</p>
        }
        else if (sim == null || sim.Overall.N == 0)
        {
            <p class="sim-sub">計算中…</p>
        }
        else
        {
            var o = sim.Overall;
            <div class="sim-head">
                <b>この局面から</b>
                <span>@(simProg < 1 ? "計算中 " + Pct(simProg) : o.N + " 回")</span>
            </div>
            @SimBar(o, 22)
            <div class="sim-nums">
                和了 <b>@Pct(o.WinRate)</b>　放銃 <b>@Pct(o.DealInRate)</b>　流局 <b>@Pct(o.DrawRate)</b>　収支 <b>@Pts(o.MeanDelta)</b>
            </div>
            @if (sim.Cands.Count > 0)
            {
                int actual = ActualCand(s, v);
                var order = Enumerable.Range(0, sim.Cands.Count).OrderByDescending(i => sim.Cands[i].R.MeanDelta).ToList();
                <div class="sim-head"><b>操作ごとの比較</b><span>平均収支の高い順</span></div>
                <table class="sim-tbl">
                    <thead><tr><th>操作</th><th></th><th>和了</th><th>放銃</th><th>流局</th><th>収支</th></tr></thead>
                    <tbody>
                        @foreach (int i in order)
                        {
                            var c = sim.Cands[i];
                            <tr class="@(i == order[0] ? "best" : null)">
                                <td class="op">
                                    @if (c.Tile.HasValue)
                                    {
                                        <img src="@Url(c.Tile.Value, false)" />
                                    }
                                    <span>@c.Label@(i == actual ? "（牌譜）" : "")</span>
                                </td>
                                <td class="bar">@SimBar(c.R, 12)</td>
                                <td>@Pct(c.R.WinRate)</td>
                                <td>@Pct(c.R.DealInRate)</td>
                                <td>@Pct(c.R.DrawRate)</td>
                                <td>@Pts(c.R.MeanDelta)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        @SimTrend(v)
    };

    // 推移グラフの寸法（仮想座標）と線
    const double GW = 300, GH = 130, GL = 30, GR = 6, GT = 8, GB = 20;
    static readonly double[] GridLines = { 0, 0.25, 0.5, 0.75, 1 };
    static string GridLabel(double g) => (g * 100).ToString("0") + "%";
    static readonly (string name, string cls, Func<SimOutcome, double> f)[] TrendLines =
    {
        ("和了率", "sv0", o => o.WinRate), ("放銃率", "sv1", o => o.DealInRate), ("流局率", "sv4", o => o.DrawRate)
    };

    double GX(int j) => GL + (GW - GL - GR) * (S.Log.Count <= 1 ? 0 : (double)j / (S.Log.Count - 1));
    static double GY(double r) => GT + (GH - GT - GB) * (1 - r);

    List<(int j, SimOutcome o)> TrendPoints()
    {
        var o = new List<(int j, SimOutcome o)>();
        for (int j = 0; j < S.Log.Count; j++)
        {
            SimOutcome x;
            if (trend.TryGetValue(S.Log[j], out x)) o.Add((j, x));
        }
        return o;
    }

    string Poly(List<(int j, SimOutcome o)> pts, Func<SimOutcome, double> f) =>
        string.Join(" ", pts.Select(p => F(GX(p.j)) + "," + F(GY(f(p.o)))));

    /// <summary>局面列に沿った和了率・放銃率・流局率の推移（計算済みの手だけ点を打つ）。</summary>
    RenderFragment SimTrend(int v) => __builder =>
    {
        var log = S.Log;
        var pts = TrendPoints();
        double W = GW, H = GH, L = GL, R = GR, T = GT, B = GB;
        var lines = TrendLines;
        <div class="sim-head">
            <b>局面ごとの推移</b>
            <span>@(trendProg >= 0 ? "計算中 " + Pct(trendProg) : pts.Count + " / " + log.Count + " 手")</span>
        </div>
        <div class="sim-leg">
            @foreach (var ln in lines)
            {
                <span><i class="sw ln @ln.cls"></i>@ln.name</span>
            }
        </div>
        <svg class="strend" viewBox="0 0 @F(W) @F(H)">
            @foreach (double g in GridLines)
            {
                <g>
                    <line class="grid" x1="@F(L)" x2="@F(W - R)" y1="@F(GY(g))" y2="@F(GY(g))" />
                    <text class="ax" x="@F(L - 4)" y="@F(GY(g))">@GridLabel(g)</text>
                </g>
            }
            <text class="ax mid" x="@F((L + W - R) / 2)" y="@F(H - 4)">手（局面）</text>
            <line class="cur" x1="@F(GX(S.Cx))" x2="@F(GX(S.Cx))" y1="@F(T)" y2="@F(H - B)" />
            @foreach (var ln in lines)
            {
                if (pts.Count >= 2)
                {
                    <polyline class="tl @ln.cls" points="@Poly(pts, ln.f)" />
                }
                foreach (var p in pts)
                {
                    <circle class="td @ln.cls" cx="@F(GX(p.j))" cy="@F(GY(ln.f(p.o)))" r="2.5" />
                }
            }
            @foreach (var p in pts)
            {
                int jj = p.j;
                <rect class="hit" x="@F(GX(p.j) - 3)" y="@F(T)" width="6" height="@F(H - T - B)" @onclick="() => S.Go(jj)">
                    <title>@(log[p.j].Jn)巡目 @ViewerState.FirstLine(log[p.j].Msg)　和了 @Pct(p.o.WinRate)　放銃 @Pct(p.o.DealInRate)　流局 @Pct(p.o.DrawRate)</title>
                </rect>
            }
        </svg>
    };

    public void Dispose()
    {
        simCts?.Cancel();
        trendCts?.Cancel();
        timer?.Dispose();
        self?.Dispose();
    }
}
